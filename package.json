{
  "name": "pecset",
  "private": true,
  "version": "0.1.0",
  "packageManager": "bun@1.4.2",
  "type": "module",
  "description": "Client-side digital PDF signing with a .p12/.pfx certificate: invisible, Adobe-style visible and custom-image visible signatures, with signature-chain support.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "verify:sign": "tsx scripts/verify-sign.ts"
  },
  "dependencies": {
    "@cantoo/pdf-lib": "^2.11.1",
    "idb": "^8.0.3",
    "node-forge": "^1.4.0",
    "pdfjs-dist": "^6.3.289",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/node-forge": "^1.3.14",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  }
}
